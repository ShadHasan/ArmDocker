curl -X GET "http://127.0.0.1:5984/inventory/_all_docs?skip=0&limit=1&include_docs=true" -H "Authorization: Basic YWRtaW46UEFKSUhJTkc="

curl -X PUT "http://127.0.0.1:5984/order" -H "Authorization: Basic YWRtaW46UEFKSUhJTkc="

# UPDATE
curl -X PUT http://127.0.0.1:5984/order/<require existing ID> \
     -H "Content-Type: application/json" \
     -H "Authorization: Basic YWRtaW46UEFKSUhJTkc=" \
     -d '{"altname": "Jane_Doe", "status": "shipped", "items": { "PRD-383482-2392": 2, "PRD-3267192-5891": 1 }, "total": 79.97, "date": "2026-09-28 09:11"}'

# CREATE
curl -X POST http://127.0.0.1:5984/order \
     -H "Content-Type: application/json" \
     -H "Authorization: Basic YWRtaW46UEFKSUhJTkc=" \
     -d '{
	     	"altname": "Jane_Doe", 
	     	"status": "shipped", 
	     	"items": { "PRD-383482-2392": 2, "PRD-3267192-5891": 1 }, 
	     	"total": 79.97, "date": "2026-09-28 09:11"
     	}'

