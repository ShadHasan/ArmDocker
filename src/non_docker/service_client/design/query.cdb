# GET by ALTName matching

curl -X POST http://127.0.0.1:5984/order/_find -H "Authorization: Basic YWRtaW46UEFKSUhJTkc=" \
	-H "Content-Type: application/json" \
	-d '{
		"selector": {
         "altname": "Jane_Doe"
       }
	}'
	
# `altname` indexing for `order` database with indexname `index-order-altname`

curl -X POST http://127.0.0.1:5984/order/_index \
     -H "Content-Type: application/json" \
     -H "Authorization: Basic YWRtaW46UEFKSUhJTkc=" \
     -d '{
       "index": {
         "fields": ["altname"]
       },
       "name": "index-order-altname",
       "type": "json"
     }'
	


